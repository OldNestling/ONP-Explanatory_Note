/* 
========================================= Справка =======================================
Данный шаблон пояснительной записки для раздела №1 проектной документации 
линейного объекта капитального строительства (для автомобильных дорог) является частью 
open-source проекта, репозиторий которого доступен по следующей ссылке: 
https://github.com/OldNestling/ONP-Explanatory_Note.git

---------------------------------------- Инструкция --------------------------------------
Основное тело документа располагается после строки-разграничителя "Документ"

Текст элементов основной надписи и страницы редактируется в секции 
"Настройки" -> "Инициализация" в соответствующих полях

Примеры написания текста на языке разметки Typst можно получить по следующим источникам:
- на официальном странице документации Typst https://typst.app/docs/
*/

// ===================================== Настройки ======================================
#import "01_Шаблоны/ШАБЛОН_ГОСТ2_105.typ": apply

// ----------------------------------- Форматирование -----------------------------------
#import "01_Шаблоны/ФУНКЦИИ.typ": (
	содержание,					// Используется для автоматизированного создания содержания
	таблица, 						// Используется для размещения таблицы в документе (см. справку)
	изображение, 				// Используется для размещения рисунка в документе (см. справку)
	заголовок, 					// Используется для отдельных заголовков без нумерации, вне содержания
	разрыв, 						// Используется для переноса последующего контента на новый лист
	перенос,						// Используется для переноса последующего контента на новую строку
	цвет_текста,				// Используется для окрашивания текста (см. справку)
	изм,								// Добавляет метку внесения изменения в тело текста
	повернуть_текст,		// поворачивает текст в ячейке таблицы
	продолжение_табл,		// добавляет отметку о продолжении таблицы
	формула_без_номера,	// аналогично формуле $ $, но без номера
	отступ_вертикальный,
	отступ_горизонтальный,
	форматировать,			// преобразует число к более к заданному формату отображения

	// --- Математика ---
	округлить,		// Используется для математической операции округления
	степень,			// Используется для математической операции возведения в степень
	корень,				// Используется для математической операции вычисления корня числа
	вычислить			// Используется для вычисления математического выражения в виде строки
)

// ==================================== Переменные =======================================
#import "01_ИСХОДНЫЕ_ДАННЫЕ.typ": (
	ОБЪЕКТ, ШИФР, 
	ОРГАНИЗАЦИЯ, КОНТРАКТ, ЗАКАЗЧИК, ГЕНПОДРЯДЧИК, ДАТА_ДОГОВОРА, 
	ОРГАНИЗАЦИЯ, ГИП, СВИДЕТЕЛЬСТВО
)

#import "02_Переменные.typ": (
	// Характеристика трассы
	ТРАССА,
	// Земляные работы
	МАКС_ВЫСОТА_НАСЫПИ, МАКС_ГЛУБИНА_ВЫЕМКИ,
	ЗР, 				// Данные по земляным работам
	ИСТОЧНИКИ,	// Данные о доставке материалов 
	ТЭП					// данные по технико-экономическим показателям
)

// перечень 
#import "03_НТД.typ": НТД, список_НТД
// Поля основной надписи
#let ДАТА = "10.26"
#let ШИФР_РАЗДЕЛА = "ПЗ"
#let РУКОВОДИТЕЛЬ = ""
#let НАЧАЛЬНАЯ_СТРАНИЦА = 4

// ================================== Инициализация ======================================
#show: apply.with(
	// Переменные штампа
	ШИФР: [#ШИФР\-#ШИФР_РАЗДЕЛА],
	НАЧАЛЬНАЯ_СТРАНИЦА: НАЧАЛЬНАЯ_СТРАНИЦА,

	РАЗРАБОТЧИК: "OldNestling",
	ПРОВЕРИЛ: "",
	РУКОВОДИТЕЛЬ: РУКОВОДИТЕЛЬ,
	НКОНТРОЛЬ: "",
	ГИП: ГИП,

	РАЗРАБОТЧИК_ПОДПИСЬ: none,
	ПРОВЕРИЛ_ПОДПИСЬ: none,
	РУКОВОДИТЕЛЬ_ПОДПИСЬ: none,
	НКОНТРОЛЬ_ПОДПИСЬ: none,
	ГИП_ПОДПИСЬ: none,

	ДАТА1: ДАТА,
	ДАТА2: ДАТА,
	ДАТА3: ДАТА,
	ДАТА4: ДАТА,
	ДАТА5: ДАТА,

	// Данные метки о изменениях в первой строке (с низу)
	ИЗМ1: 0,
	ИЗМ1_ЛИСТ: "",
	ИЗМ1_ДОК: "",
	ИЗМ1_ДАТА: "",
	
	// Данные метки о изменениях во второй строке (сверху)
	ИЗМ2: 0,
	ИЗМ2_ЛИСТ: "",
	ИЗМ2_ДОК: "",
	ИЗМ2_ДАТА: "",

	ВСЕ_ЛИСТЫ: false,	// true --- включить отображение меток изменения на всех листах

	/*
	Указывает, на каких отдельных страницах выводится отметка изменения
	передаётся одно число номера страницы или массив номеров. Например:
	4 или (4, 5, 6). По умолчанию отключено в режиме none
	*/
	СТРАНИЦЫ_ИЗМЕНЕНИЯ_1: none,
	СТРАНИЦЫ_ИЗМЕНЕНИЯ_2: none
)

// Содержание (автоматическое)
#содержание(межстрочный: 2.3mm, начальная_страница: НАЧАЛЬНАЯ_СТРАНИЦА)

