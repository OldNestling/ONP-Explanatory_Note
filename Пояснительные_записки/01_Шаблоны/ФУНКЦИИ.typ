// =================================== Форматирование ===================================

/// Автоматические формирует содержание документа по заголовкам.
/// Параметры `высота_текста` и `межстрочный` используются для регулировки занимаемого
/// места списком содержания
///
/// - заголовок (): Заголовок списка содержания. По умолчанию — "Содержание";
/// - высота_текста (): Высота текста в перечне содержания документа;
/// - межстрочный (): Межстрочный интервал в перечне содержания документа.
/// - начальная_страница (): Отсчёт первой страницы для оглавления
/// -> 
#let содержание(
	заголовок: "Содержание", 
	высота_текста: 12pt,
	межстрочный: 2mm,
	начальная_страница: 1
) = {
	//pagebreak(weak: true)

	// Увеличиваем нижнее поле до 45 мм (остальные поля – как в ГОСТ)
	set page(margin: (left: 25mm, right: 11mm, top: 18mm, bottom: 45mm))

	align(center)[
		#set heading(numbering: none)
		#heading(level: 1, outlined: false)[#заголовок]
	]

	set par(first-line-indent: 0mm, leading: межстрочный)

	// Сброс стиля ссылок в этой области видимости
	show link: set text(fill: black, weight: "regular")

	show outline.entry: it => {
		let offset = начальная_страница - 1
		let loc = it.element.location()
		let page_num = counter(page).at(loc).first() + offset
		link(
			loc,
			it.indented(
				it.prefix(),
				{
					it.body()
					box(width: 1fr, it.fill)
					str(page_num)
				}
			)
		)
	}

	text(outline(title: none, indent: 1em, depth: 3), size: высота_текста)
	
	// Возвращаем исходное нижнее поле 25 мм
	set page(margin: (left: 25mm, right: 11mm, top: 18mm, bottom: 25mm))
	//pagebreak(weak: true)
}


/// Функция для вставки таблицы с заголовком "Таблица X — Название" с автоматической нумерацией
///
/// - наименование (): Опциональное наименование для всей таблицы
/// - body (): функция `table` c параметрами и контентом таблицы
/// -> 
#let таблица(наименование: none, body) = {
  figure(
    kind: "table",
		supplement: "табл.",
    caption: if наименование != none { наименование } else { none },
    body
  )
}

/// Функция для вставки изображения с подписью "Рисунок X — Название" с автоматической нумерацией
///
/// - наименование (): наименование приведённого изображения
/// - файл (): путь в файловой системе к ресурсу изображения.
/// - размер (): опциональный параметр для регуоирования размера изображения
/// -> 
#let изображение(
	наименование: "изображение", 
	файл: none, 
	относительный: false, 
	размер: 50%
) = {
	let path_normalization = if файл.starts-with("/") and not относительный {
		файл
	} else {
		"/" + файл
	}

	figure(
		kind: "image",
		supplement: "рис.",
		caption: наименование,
		image(path_normalization, width: размер)
	)
}


/// Создаёт отдельный заголовок, по умолчанию без нумерации включения в содержание
///
/// - текст (): Текст заголовка
/// - нумерация (): нумерация, по умолчанию none, стандартная "1"
/// - уровень (): Иерархический уровень заголовка. По умолачнию 1 уровня
/// - учитывать (): Учитывать ли заголовок в содержании. true, если да. По умолчанию отключено.
/// -> 
#let заголовок(текст, нумерация: none, уровень: 1, учитывать: false) = {
	heading(numbering: нумерация, level: уровень, outlined: учитывать)[#текст]
}


/// Создаёт разрыв листа для контента в позиции расположения функции
///
/// ->
#let разрыв() = {
	pagebreak()
}


/// Создаёт перенос последующего текста на новую строку с выравниванием контента
/// предыдущей строки 
///
/// -> 
#let перенос() = {
	linebreak(justify: true)
}


/// Окрашивает следующий цвет в квадратных скобках: [текст]
///
/// - body (): 
/// - цвет (): По умолчанию красный, можно переопрделить с помощью rgb("000000") или названием цвета, например blue
/// -> Текст
#let цвет_текста(цвет: rgb("#ff0000"), body) = {
  text(fill: цвет, body)
}


/// Вставляет метку о изменении для абзаца
///
/// - номер (): номер изменения
/// - x (): смещение по горизонтали
/// - y (): смещение по вертикали
/// -> 
#let изм(номер, x: 0mm, y: -6mm) = {
	place(
		right,
		dx: x,
		dy: y,
		skew(ax: -15deg)[#table(
			columns: 10mm,
			[#номер]
		)]
	)
}


/// Поворачивает текст в ячейке таблицы
///
/// - body (): текст в виде контента: `#повернуть_текст()[Поворачиваемый текст]`
/// -> 
#let повернуть_текст(body) = {rotate(-90deg, reflow: true)[#body]} 


#let продолжение_табл(номер, x: 0mm, y: -5mm) = {
	place(
		left + top,
		text([_Продолжение таблицы #номер _]),
		dx: x,
		dy: y
	)

}


/// Цинтрированная формула без номерации
/// 
/// -> 
#let формула_без_номера = math.equation.with(block: true, numbering: none)


/// Добавляет вертикальный отступ для последующего текста
///
/// - отступ (): параметр вертикального смещения
/// -> 
#let отступ_вертикальный(отступ: 5mm) = {v(отступ)}


/// Добавляет горизонтальный отступ для последующего текста (контент в квадратных скобках)
///
/// - отступ (): параметр горизонтального смещения
/// -> 
#let отступ_горизонтальный(отступ: 5mm) = {h(отступ)}


// =============================== Математика =================================

/// Округляет число
///
/// - число (): округляемое число
/// - точность (): количество знаков после запятой
/// -> число
#let округлить(число, точность: 2) = {
	calc.round(число, digits: точность)
}


/// Возводит число в степень
///
/// - число (): 
/// - n (): степень
/// -> число
#let степень(число, n) = {calc.pow(число, n)}


/// Вычисляет значение корня n-ой степени 
///
/// - число (): подкоренное выражение
/// - степень (): показатель степени
/// -> 
#let корень(число, степень: 2) = {calc.root(число, степень)}


/// Производит вычисление и округление результата на для математического выражения
///
/// - выражение (): строка с формулой для вычисления
/// - точность (2): разряд округления 
/// ->  
#let вычислить(выражение, точность: 2) = {calc.round(eval(выражение, mode: "code"), digits: точность)}


/// Функция для форматирования чисел
///
/// - число (): число, которое следует отформатировать
/// - точность (): количество знаков после запятой
/// - разделитель_дроби (): разделитель дробной части
/// - разделитель_тысяч (): разделитель тысяч
/// -> 
#let форматировать(
  число,
  точность: 0,          
  разделитель_дроби: ",",
  разделитель_тысяч: " ",
) = {
  let integer = calc.trunc(число)
  let decimal = calc.fract(число)
  // Группируем целую часть по 3 цифры справа налево
  let res = str(integer)
    .clusters()
    .rev()
    .chunks(3)
    .map(c => c.join(""))
    .join(разделитель_тысяч)
    .rev()

  // Добавляем дробную часть, если нужно
  if точность != 0 {
    res += разделитель_дроби
    // Округляем и форматируем дробную часть
    decimal = calc.round(decimal, digits: точность)
    let decimal-str = str(decimal).slice(2) // Убираем "0."
    // Добавляем незначащие нули, если нужно
    if точность > decimal-str.len() {
      decimal-str += "0" * (точность - decimal-str.len())
    }
    res += decimal-str.slice(0, точность)
  }
  return res
}